    "@vueuse/core": "^15.0.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@intlify/message-compiler": "^11.4.18",
    "playwright-core": "^1.64.1",
    "pngjs": "^7.0.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.14"
