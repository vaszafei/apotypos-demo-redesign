{
  "name": "apotypos-web",
  "private": true,
  "type": "module",
  "scripts": {
    "sync": "node scripts/sync-prototype.mjs",
    "dev": "npm run sync && nuxt dev",
    "generate": "npm run sync && nuxt generate",
    "preview": "nuxt preview",
    "typecheck": "npm run sync && nuxt typecheck",
    "check": "node ../docs/redesign/prototypes/scripts/check.mjs",
